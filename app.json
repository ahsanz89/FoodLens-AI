{
  "expo": {
    "name": "FoodLens AI",
    "slug": "foodlens-ai",
    "scheme": "foodlens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAF7"
    },
    "android": {
      "package": "com.foodlens.ai",
      "adaptiveIcon": {
        "backgroundColor": "#2E8B57",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA"
      ],
      "blockedPermissions": [
        "RECORD_AUDIO"
      ],
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "FoodLens AI uses the camera only when you tap Scan, to identify ingredients.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo of your ingredients to analyze."
        }
      ],
      "expo-notifications",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "userTrackingPermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "da4ba8c1-c2dd-495b-ab03-f77eacce3a5e"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "ahsanzaheer89s-team"
  }
}